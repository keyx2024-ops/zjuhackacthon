# 环境变量配置示例
# 复制此文件为项目根目录下的 .env 并填入实际值

# === LLM 提供方（OpenAI 兼容端点）===
# 支持任意 OpenAI 兼容服务：pincc.ai、官方 OpenAI、Azure OpenAI、vLLM、Ollama 等
PROVIDER_BASE_URL=https://v2.pincc.ai
PROVIDER_AUTH_TOKEN=sk-your-token-here
MODEL_NAME=claude-haiku-4-5-20251001

# === API 服务 ===
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# === 数据库 ===
DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_integration
SQLALCHEMY_ECHO=False

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Neo4j（可选）===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# === 向量嵌入 ===
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# === 文件上传 ===
MAX_UPLOAD_SIZE=524288000
UPLOAD_DIR=./data/uploads

# === 日志 ===
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# === 前端 ===
FRONTEND_URL=http://localhost:3000
